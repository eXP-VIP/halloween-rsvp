rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require a Firebase Authentication identity before any staff profile or protected event data can be accessed.
    function signedIn() {
      return request.auth != null;
    }

    // Use the caller’s Auth UID as the role-document key; a client-supplied username is not an identity proof.
    function staffRecordPath(uid) {
      return /databases/$(database)/documents/event_users/$(uid);
    }

    // Resolve the caller’s role record and require active == true before granting staff reads or writes.
    function isActiveStaff() {
      return signedIn()
        && exists(staffRecordPath(request.auth.uid))
        && get(staffRecordPath(request.auth.uid)).data.active == true
        && get(staffRecordPath(request.auth.uid)).data.role in ['admin', 'hotel', 'internations'];
    }

    // Check a named role only after confirming the user is an active staff member.
    function hasRole(roleName) {
      return isActiveStaff()
        && get(staffRecordPath(request.auth.uid)).data.role == roleName;
    }

    // Admin role predicate for broad guest management and event configuration.
    function isAdmin() {
      return hasRole('admin');
    }

    // Hotel/check-in role predicate for the restricted check-in workflow.
    function isHotel() {
      return hasRole('hotel');
    }

    // InterNations role predicate for payment and referral-drink operations.
    function isInterNations() {
      return hasRole('internations');
    }

    // Validate the older public RSVP document shape for backward compatibility; do not broaden this without reviewing client versions.
    function isLegacyPublicRsvpCreate() {
      return request.resource.data.keys().hasAll(['name', 'invitedBy', 'checkedIn', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'invitedBy', 'checkedIn', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.invitedBy is string
        && request.resource.data.invitedBy.size() <= 120
        && request.resource.data.checkedIn == false
        && request.resource.data.createdAt == request.time;
    }

    // Validate the current public RSVP document shape and safe initial field values for anonymous submission.
    function isFullPublicRsvpCreate() {
      return request.resource.data.keys().hasAll([
          'name', 'firstName', 'lastName', 'invitedBy',
          'checkedIn', 'checkedInAt', 'paid', 'paidAt',
          'welcomeDrinkChipIssued', 'guestType', 'source', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'firstName', 'lastName', 'invitedBy',
          'checkedIn', 'checkedInAt', 'paid', 'paidAt',
          'welcomeDrinkChipIssued', 'guestType', 'source', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() >= 1
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() <= 120
        && request.resource.data.invitedBy is string
        && request.resource.data.invitedBy.size() <= 120
        && request.resource.data.checkedIn == false
        && request.resource.data.checkedInAt == null
        && request.resource.data.paid == false
        && request.resource.data.paidAt == null
        && request.resource.data.welcomeDrinkChipIssued == false
        && request.resource.data.guestType == 'friend'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
    }

    // Accept only one of the explicitly recognized public RSVP payload shapes.
    function isPublicRsvpCreate() {
      return isLegacyPublicRsvpCreate() || isFullPublicRsvpCreate();
    }

    // Restrict hotel staff updates to check-in-related fields; do not add payment or admin fields here.
    function hotelCheckInUpdate() {
      return isHotel()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt'])
        && request.resource.data.checkedIn is bool
        && (request.resource.data.checkedIn
          ? (request.resource.data.get('checkedInAt', null) == request.time
              || request.resource.data.get('checkedInAt', null) == resource.data.get('checkedInAt', null))
          : request.resource.data.get('checkedInAt', null) == null
            && resource.data.get('paid', false) != true
            && resource.data.get('welcomeDrinkChipIssued', false) != true
            && resource.data.get('welcomeDrinkUpgradeSelected', false) != true);
    }

    // Allow broad guest-document updates only for an active Admin.
    function adminGuestUpdate() {
      return isAdmin()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkedIn'])
          || resource.data.get('checkedIn', false) != true
          || request.resource.data.get('checkedIn', false) != false
          || (
            resource.data.get('paid', false) != true
            && resource.data.get('welcomeDrinkChipIssued', false) != true
            && resource.data.get('welcomeDrinkUpgradeSelected', false) != true
          )
        );
    }

    // In single-team mode, InterNations may also change only check-in fields; the workflow document gates this exception.
    function singleTeamInterNationsCheckInUpdate() {
      return isInterNations()
        && get(/databases/$(database)/documents/event_settings/workflow).data.get('twoStepCheckInEnabled', true) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt'])
        && request.resource.data.checkedIn is bool
        && (
          request.resource.data.checkedIn
            ? (request.resource.data.get('checkedInAt', null) == request.time
                || request.resource.data.get('checkedInAt', null) == resource.data.get('checkedInAt', null))
            : request.resource.data.get('checkedInAt', null) == null
              && resource.data.get('paid', false) != true
              && resource.data.get('welcomeDrinkChipIssued', false) != true
              && resource.data.get('welcomeDrinkUpgradeSelected', false) != true
        );
    }

    // Restrict payment staff updates to the explicit payment, qualifying-referral chip and drink-upgrade field allowlist.
    function interNationsPaymentUpdate() {
      return isInterNations()
        && resource.data.checkedIn == true
        && request.resource.data.checkedIn == resource.data.checkedIn
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paid', 'paidAt', 'amountPaid', 'paymentStatusUpdatedAt',
          'welcomeDrinkChipIssued', 'welcomeDrinkChipIssuedAt', 'welcomeDrinkChipIssuedBy',
          'welcomeDrinkUpgradeSelected', 'welcomeDrinkUpgradePrice', 'welcomeDrinkUpgradeUpdatedAt'
        ]);
    }

    // Staff identity and role records are readable only by their owner (single document) or an Admin; browsers cannot mutate roles.
    match /event_users/{uid} {
      // Provision roles in Firebase Console or with a trusted Admin SDK only.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Guest-list reads are staff-only; public visitors can create an RSVP but cannot enumerate, edit or delete guest records.
    match /halloween_guests/{guestId} {
      allow get, list: if isActiveStaff();
      allow create: if isAdmin() || isPublicRsvpCreate();
      allow update: if adminGuestUpdate() || hotelCheckInUpdate() || singleTeamInterNationsCheckInUpdate() || interNationsPaymentUpdate();
      allow delete: if isAdmin();
    }

    // Public visitors may submit a cancellation request, but cannot read or alter requests.
    // Existing guest deletion permissions remain unchanged.
    match /cancellation_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedBy'])
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt == request.time
        && request.resource.data.completedBy is string
        && request.resource.data.completedBy.size() <= 128;
      allow delete: if false;
    }

    // Workflow and pricing settings are visible to active staff but writable only by an Admin.
    match /event_settings/{settingId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    // Legacy unregistered-inviter reward records are retired: referral drinks are for members only.
    match /welcome_drink_rewards/{rewardId} {
      allow read, write: if false;
    }
  }
}
